# Environment variable contract — NAMES ONLY. Never commit real values.
# Copy to .env.local (git-ignored) and fill in from Neon.

# RUNTIME: pooled Neon endpoint + RESTRICTED application role (kornizo_app).
# Used by the app at runtime and by the RLS integration tests.
DATABASE_URL=

# MIGRATIONS / ADMIN: direct (unpooled) endpoint + PRIVILEGED owner role.
# Used by drizzle-kit and one-off admin/setup scripts. Never the pooled URL.
DATABASE_MIGRATION_URL=

# Direct/unpooled owner URL as originally provisioned by Neon (kept for
# reference / bootstrapping the migration URL).
DATABASE_URL_UNPOOLED=

# --- AUTH (Better Auth runtime) ---
# REQUIRED IN PRODUCTION. Locally, missing values fall back to insecure dev
# defaults; a real deployment MUST set both or sessions are unsafe.
#
# BETTER_AUTH_SECRET: a strong, unique random string (e.g. `openssl rand -base64 32`).
# Signs session cookies/tokens — never reuse the dev value in production.
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL: the canonical public origin of the deployment, scheme + host,
# no trailing slash (e.g. https://app.example.com). Used for cookies and as the
# trusted origin. Must match the URL users actually load.
BETTER_AUTH_URL=
